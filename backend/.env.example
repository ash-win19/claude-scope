DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.claude-scope.com
PORT=3000
FRONTEND_URL=http://localhost:8080
ANTHROPIC_API_KEY=sk-ant-...your-key-here
# 32-byte hex key for encrypting user API credentials
# Generate with: openssl rand -hex 32
# IMPORTANT: This must be set or API key storage will fail with a 500 error
CREDENTIAL_ENCRYPTION_KEY=your-64-char-hex-key-here
